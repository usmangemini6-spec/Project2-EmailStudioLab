{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "number" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "problem": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["file", "line", "severity", "problem", "fix"]
      }
    }
  },
  "required": ["findings"]
}
